\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Computational architecture of \texttt  {metasignal}. Trial-level arrays flow top-down through four layers: (1) \texttt  {stdpy} computes SDT statistics and all twenty metacognitive measures; (2) \texttt  {compute\_all\_measures} returns the full 26-element output; (3) \texttt  {analysis} provides bootstrap CIs, permutation tests, and group summaries, and the CLI exposes the full measure suite without Python code; (4) two experimental, pre-1.0 components---\texttt  {sdtbayes}, offering seven Bayesian estimation approaches that return a \texttt  {FitResult} with shared diagnostics, and \texttt  {itmc}, an information-theoretic metacognition module.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:architecture}{{1}{3}{Computational architecture of \texttt {metasignal}. Trial-level arrays flow top-down through four layers: (1) \texttt {stdpy} computes SDT statistics and all twenty metacognitive measures; (2) \texttt {compute\_all\_measures} returns the full 26-element output; (3) \texttt {analysis} provides bootstrap CIs, permutation tests, and group summaries, and the CLI exposes the full measure suite without Python code; (4) two experimental, pre-1.0 components---\texttt {sdtbayes}, offering seven Bayesian estimation approaches that return a \texttt {FitResult} with shared diagnostics, and \texttt {itmc}, an information-theoretic metacognition module}{figure.1}{}}
